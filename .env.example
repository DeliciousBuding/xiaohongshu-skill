# Live-test switches. Default checks do not contact Xiaohongshu.
XHS_LIVE_TEST=0
XHS_LIVE_KEYWORD=咖啡
XHS_LIVE_HEADLESS=true

# Optional default named profile.
XHS_PROFILE=

# Optional process-local fingerprint seed override.
XHS_FP_SEED=

# Keep unset for normal use. Enable only in an isolated environment that requires it.
XHS_ALLOW_NO_SANDBOX=false
